{
  "name": "@org/pdf-shop-worker-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "pdf-shop-worker-e2e",
    "implicitDependencies": [
      "pdf-shop-worker"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "pdf-shop-worker:build",
          "pdf-shop-worker:serve"
        ],
        "options": {
          "jestConfig": "packages/pdf-shop/worker-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
