# Root directory for persisted specs/payments. Defaults to /tmp/pdf-shop-data if unset.
PDF_SHOP_DATA_DIR=/tmp/pdf-shop-data
LOG_LEVEL=trace
PRETTY_PRINT_LOGS=true
# Stripe sandbox/test keys — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
