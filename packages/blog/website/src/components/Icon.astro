---
// Minimal hand-authored icon set - avoids pulling in an icon library for
// three glyphs. Matches the reference site's circular social-icon-button
// pattern (see Sidebar.astro for the surrounding button styling).
type IconName = 'email' | 'github' | 'linkedin'

interface Props {
	name: IconName
}

const { name } = Astro.props

const paths: Record<IconName, string> = {
	email:
		'M2 4h20v16H2V4zm2 2.3V18h16V6.3l-8 6.4-8-6.4zm.8-.3L12 10.4 19.2 6H4.8z',
	github:
		'M12 2C6.48 2 2 6.58 2 12.253c0 4.537 2.865 8.383 6.839 9.742.5.094.683-.223.683-.494 0-.244-.009-.89-.014-1.747-2.782.617-3.369-1.36-3.369-1.36-.454-1.178-1.11-1.492-1.11-1.492-.908-.63.069-.617.069-.617 1.003.072 1.531 1.049 1.531 1.049.892 1.55 2.341 1.102 2.91.843.092-.655.35-1.102.636-1.355-2.221-.256-4.555-1.13-4.555-5.032 0-1.112.39-2.022 1.029-2.734-.103-.256-.446-1.29.098-2.688 0 0 .84-.272 2.75 1.044A9.35 9.35 0 0 1 12 6.844c.85.004 1.705.116 2.504.34 1.909-1.316 2.747-1.044 2.747-1.044.546 1.398.203 2.432.1 2.688.64.712 1.028 1.622 1.028 2.734 0 3.912-2.339 4.773-4.566 5.024.359.316.679.938.679 1.891 0 1.365-.012 2.466-.012 2.8 0 .273.18.592.688.492A10.03 10.03 0 0 0 22 12.253C22 6.58 17.52 2 12 2z',
	linkedin:
		'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.71h.05c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V21h-4V9z',
}
---

<svg
	class="icon"
	viewBox="0 0 24 24"
	width="1em"
	height="1em"
	aria-hidden="true"
	focusable="false"
>
	<path fill="currentColor" d={paths[name]}></path>
</svg>
