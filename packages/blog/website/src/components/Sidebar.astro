---
import { Icon } from 'astro-icon/components'
import { SITE_TITLE, GITHUB_REPO_URL } from '../consts'
import Avatar from './Avatar.astro'
import BuiltWith from './BuiltWith.astro'
import HeaderLink from './HeaderLink.astro'

const navItems = [
	{ href: '/', label: 'Home' },
	// Shares its first path segment with '/tags/<slug>', so this stays
	// highlighted on tag pages too - HeaderLink matches on that segment.
	{ href: '/tags', label: 'Tags' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
]

export const buildWithItems = [
  {
    name: 'simple-icons:typescript' as const,
    label: 'TypeScript',
    href: 'https://www.typescriptlang.org',
  },
  {
    name: 'simple-icons:react' as const,
    label: 'React',
    href: 'https://react.dev',
  },
  {
    name: 'simple-icons:nodedotjs' as const,
    label: 'Node.js',
    href: 'https://nodejs.org',
  },
  {
    name: 'simple-icons:astro' as const,
    label: 'Astro',
    href: 'https://astro.build',
  },
  {
    name: 'simple-icons:nextdotjs' as const,
    label: 'Next.js',
    href: 'https://nextjs.org',
  },
  {
    name: 'simple-icons:payloadcms' as const,
    label: 'Payload CMS',
    href: 'https://payloadcms.com',
  },
  {
    name: 'simple-icons:sqlite' as const,
    label: 'SQLite',
    href: 'https://www.sqlite.org',
  },
  {
    name: 'simple-icons:docker' as const,
    label: 'Docker',
    href: 'https://www.docker.com',
  },
  {
    name: 'simple-icons:nginx' as const,
    label: 'nginx',
    href: 'https://nginx.org',
  },
  {
    name: 'simple-icons:googlecloud' as const,
    label: 'Google Cloud',
    href: 'https://cloud.google.com',
  },
  {
    name: 'simple-icons:pulumi' as const,
    label: 'Pulumi',
    href: 'https://www.pulumi.com',
  },
]

---

<aside class="sidebar">
	<div class="sidebar__inner">
		<div class="sidebar__content">
			<a href="/" class="author__photo-link">
				<Avatar size={96} />
			</a>
			<a href="/" class="author__title">Sample Author</a>
			<p class="author__subtitle">This is a custom blog built with Astro, Payload CMS, and SQLite, showcasing a real, end-to-end integration of these technologies. It features an admin dashboard for managing content, including creating and editing posts with richtext editing, tags, drafts and media uploads.&nbsp;<a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">View source on github</a></p>
			<nav class="menu">
				<ul class="menu__list">
					{
						navItems.map((item) => (
							<li class="menu__list-item">
								<HeaderLink href={item.href}>{item.label}</HeaderLink>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
		<div>
			<p class="stack-heading">Built with</p>
			<BuiltWith />
			<p class="copyright">{SITE_TITLE} &copy; 2026</p>
		</div>
	</div>
</aside>

<style>
	.sidebar {
		display: flex;
	}
	.sidebar__inner {
		flex: 1;
		min-width: 0;
		padding-top: 2.5rem;
		display: flex;
		flex-direction: column;
	}
	.sidebar__content {
		flex: 1;
	}
	.author__photo-link {
		display: inline-block;
		line-height: 0;
	}
	.author__title {
		display: block;
		margin: 0.8125rem 0;
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.82813rem;
		color: #222;
		text-decoration: none;
	}
	.author__title:hover,
	.author__title:focus {
		color: #5d93ff;
	}
	.author__subtitle {
		margin: 0 0 1.625rem;
		color: #888;
		line-height: 1.625rem;
	}
	.stack-heading {
		margin: 0 0 0.5rem;
		color: #888;
		font-size: 0.875rem;
	}
	.menu {
		margin-bottom: 1.625rem;
	}
	.menu__list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.menu__list-item {
		margin: 0.625rem 0;
		padding: 0;
	}
	.copyright {
		margin: 0;
		color: #b6b6b6;
		font-size: 0.875rem;
	}

	@media screen and (min-width: 685px) {
		.sidebar {
			flex: 0 0 41.625%;
			min-width: 0;
			position: sticky;
			top: 0;
			min-height: 100vh;
			border-right: 1px solid #ebebeb;
		}
		.sidebar__inner {
			flex: 1;
			display: flex;
			flex-direction: column;
			min-width: 0;
			padding: 2.5rem 1.25rem 1.25rem;
		}
	}
	@media screen and (min-width: 960px) {
		.sidebar {
			flex-basis: 33.4%;
			border-right: 1px solid #ebebeb;
		}
		.sidebar__inner {
			flex: 1;
			display: flex;
			flex-direction: column;
			min-width: 0;
			padding: 2.5rem 1.25rem 1.25rem;
		}
	}
</style>
