---
export const prerender = false;

import { getLiveCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { pinoLogger } from '../logging/pino';

const { entries, error } = await getLiveCollection('blog');
if (error) {
	pinoLogger.error({ err: error }, 'Failed to load posts');
	Astro.response.status = 502;
}
const posts = (entries ?? []).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<ul class="posts">
		{posts.map((post) => <PostCard id={post.id} data={post.data} />)}
	</ul>
	{
		posts.length === 0 && !error && (
			<p class="empty">No posts published yet.</p>
		)
	}
</Layout>

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.empty {
		color: var(--text-muted);
	}
</style>
