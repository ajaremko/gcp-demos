---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, GITHUB_REPO_URL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>A Custom Blog</h1>
			<p>
				This is the custom blog built and deployed end to end. Nothing here is a real
				publication. But the stack behind it is real - a real self-hosted Payload CMS, real
				Docker releases and real GCP infrastructure.&nbsp;
				<a 
					href={GITHUB_REPO_URL} 
					target="_blank" 
					rel="noopener noreferrer"
				>
					View on Github
				</a>
			</p>
			<p><a href="/blog">Read the posts →</a></p>
		</main>
		<Footer />
	</body>
</html>
