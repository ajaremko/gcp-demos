---
import type { ImageMetadata } from 'astro'
import BaseHead from '../components/BaseHead.astro'
import Sidebar from '../components/Sidebar.astro'

interface Props {
	title: string
	description: string
	image?: ImageMetadata
}

const { title, description, image } = Astro.props
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<div class="page">
			<Sidebar />
			<div class="content">
				<div class="content__inner">
					<slot />
				</div>
			</div>
		</div>
	</body>
</html>

<style>
	.page {
		width: 100%;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 1.25rem;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	.content {
		flex: 1;
		min-width: 0;
	}
	.content__inner {
		padding: 1.5625rem 0;
	}

	@media screen and (min-width: 685px) {
		.page {
			flex-direction: row;
			align-items: flex-start;
			gap: 1.875rem;
		}
		.content__inner {
			padding: 1.875rem 0;
		}
	}
	@media screen and (min-width: 960px) {
		.content__inner {
			padding: 2.5rem 0;
			max-width: 80%;
		}
	}
	@media screen and (min-width: 1100px) {
		.content__inner {
			max-width: 60%;
		}
	}
</style>
