---
import type { ImageMetadata } from 'astro'
import BaseHead from '../components/BaseHead.astro'
import Sidebar from '../components/Sidebar.astro'

interface Props {
	title: string
	description: string
	image?: ImageMetadata
}

const { title, description, image } = Astro.props
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<div class="page">
			<Sidebar />
			<div class="content">
				<div class="content__inner">
					<slot />
				</div>
			</div>
			<div class="clearfix"></div>
		</div>
	</body>
</html>

<style>
	.page {
		width: 100%;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 1.25rem;
	}
	.clearfix {
		clear: both;
	}
	.content {
		width: 100%;
	}
	.content__inner {
		padding: 1.5625rem 0;
	}

	@media screen and (min-width: 685px) {
		.content {
			width: calc(58.375% - 0.78125rem);
			float: right;
		}
		.content__inner {
			padding: 1.875rem 0;
		}
	}
	@media screen and (min-width: 960px) {
		.content {
			width: calc(66.6% - 0.625rem);
		}
		.content__inner {
			padding: 2.5rem 0;
			max-width: 80%;
		}
	}
	@media screen and (min-width: 1100px) {
		.content__inner {
			max-width: 60%;
		}
	}
</style>
