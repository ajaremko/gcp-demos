---
import type { BlogPostData } from '../loaders/posts';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import Layout from './Layout.astro';

type Props = BlogPostData;

const { title, description, pubDate, updatedDate, heroImage, tags } =
	Astro.props;
---

<Layout title={title} description={description}>
	<nav class="navHeader">
		<a href="/" class="navHeader__home">&larr; Home</a>
	</nav>
	<article>
		<h1>{title}</h1>
		<div class="date">
			<FormattedDate date={pubDate} />
			{
				updatedDate && (
					<span class="last-updated-on">
						&middot; Last updated on <FormattedDate date={updatedDate} />
					</span>
				)
			}
		</div>
		{
			heroImage && (
				<img class="hero-image" width="1020" height="510" src={heroImage} alt="" />
			)
		}
		<div class="post__content">
			<slot />
		</div>
	</article>
	<div class="postFooter">
		<TagList tags={tags} />
	</div>
</Layout>

<style>
	.navHeader {
		border-bottom: 0.0625rem solid var(--border);
		margin-bottom: 1.625rem;
		padding-bottom: 1.625rem;
	}
	.navHeader__home {
		color: var(--text-muted);
		font-size: 1rem;
	}
	.navHeader__home:hover,
	.navHeader__home:focus {
		color: var(--link);
	}
	.hero-image {
		width: 100%;
		margin-bottom: 1.625rem;
		border-radius: 8px;
	}
	.date {
		margin-bottom: 0.8125rem;
		color: var(--text-muted);
		font-size: 0.875rem;
	}
	.last-updated-on {
		font-style: italic;
	}
	.postFooter {
		border-top: 0.0625rem solid var(--border);
		margin-top: 3.25rem;
		padding-top: 1.625rem;
	}
</style>
