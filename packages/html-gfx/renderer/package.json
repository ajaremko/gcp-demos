{
  "name": "@org/html-gfx-renderer",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "html-gfx-renderer",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/packages/html-gfx/renderer/dist/package.json",
          "{workspaceRoot}/packages/html-gfx/renderer/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/packages/html-gfx/renderer/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "html-gfx-renderer:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "html-gfx-renderer:build:development"
          },
          "production": {
            "buildTarget": "html-gfx-renderer:build:production"
          }
        }
      }
    },
    "release": {
      "docker": {
        "repositoryName": "html-gfx-renderer"
      }
    }
  },
  "dependencies": {
    "express": "^5.1.0",
    "puppeteer": "^25.10.0"
  }
}
